{
	"alias": "telegram-description-keeper",
	"name": "telegram-description-keeper",
	"builds": [
		{
			"src": "*.go",
			"use": "@vercel/go"
		}
	],
	"routes": [
		{
			"src": "/(.*)/send",
			"dest": "server.go"
		}
	],
	"env": {
		"JSONBIN_TOKEN": "KEEPER_JSONBIN_TOKEN",
		"TELEGRAM_BOT_ID": "KEEPER_TELEGRAM_BOT_ID",
		"JSONBIN_BIN_ID": "KEEPER_JSONBIN_BIN_ID"
	}
}